# Server configuration
PORT=5000
NODE_ENV=development

# MongoDB connection URI (MongoDB Atlas replica set recommended for transactions)
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority

# JWT Authentication
JWT_SECRET=your_jwt_access_secret_key_here
JWT_EXPIRES_IN=30m
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_here
JWT_REFRESH_EXPIRES_IN=7d

# CORS allowed frontend origin
CLIENT_ORIGIN=http://localhost:5173

# Razorpay payment gateway (Phase 4)
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# Open Government Data (data.gov.in) Mandi Price API (Agmarknet daily wholesale rates)
# Register at https://data.gov.in and generate your API key under "My Account"
DATA_GOV_API_KEY=your_data_gov_in_api_key_here
# Agmarknet Daily APMC Mandi commodity price bulletin resource ID
DATA_GOV_MANDI_RESOURCE_ID=9ef84268-d588-465a-a308-a864a43d0070
# Frequency in hours between scheduled background Mandi rate synchronization (default 24)
MANDI_REFRESH_INTERVAL_HOURS=24
# Number of days to retain historical APMC mandi price records in MongoDB (default 90)
MANDI_DATA_RETENTION_DAYS=90

# Firebase Cloud Messaging (Phase 11 - T11.4 Notifications)
# Optional: FCM server key for web/mobile push notification delivery.
# If not provided, notifications are persisted in-app with dev console fallback.
FCM_SERVER_KEY=your_firebase_cloud_messaging_server_key_here

# Maps Platform API Key (Phase 11 - T11.5 Nearby Market Finder)
# Default map engine uses OpenStreetMap (OSM) tile services which require no API key.
# If Google Maps Platform is used, restrict key by IP/referrer per security docs.
GOOGLE_MAPS_API_KEY=your_restricted_google_maps_api_key_here

# AI Price-Trend Microservice URL (Phase 8 - T8.3 & T8.4)
# Points to the separate Python FastAPI microservice (ai-service/)
# Node backend automatically falls back to statistical forecasting if unreachable.
AI_SERVICE_URL=http://localhost:8000

# Blockchain Provenance Ledger (Phase 6 - T6.1 & T6.2)
# Polygon Amoy Testnet (Chain ID: 80002) - Used strictly for immutable harvest provenance (Hard Rule 7)
# If omitted or offline, backend seamlessly uses deterministic cryptographic hash fallback.
POLYGON_RPC_URL=https://rpc-amoy.polygon.technology
LEDGER_CONTRACT_ADDRESS=
LEDGER_SIGNER_PRIVATE_KEY=
LEDGER_CHAIN_ID=80002

# Google Gemini API Key (Phase 12 - T12.1 & T12.2 AI Crop Doctor & Voice Assistant)
# Used for multimodal crop disease & quality inspection and conversational voice reasoning.
# Optional: if omitted, system automatically engages safe zero-hallucination basic fallback mode.
GEMINI_API_KEY=your_gemini_api_key_here

# Voice Assistant Vernacular Activation (Phase 12 - T12.3)
# Keeps Hindi and Marathi voice commands gated until native-speaker verification pass passes.
VOICE_COMMANDS_HI_MR_ENABLED=false



